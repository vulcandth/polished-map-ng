      },
      {
        "text": "Pokémon Red++",
        "bold": false,
        "italic": false,
        "mono": false,
        "small": false,
        "link": "https://github.com/TheFakeMateo/RedPlusPlus"
      },
      {
        "text": ".",
        "bold": false,
        "italic": false,
        "mono": false,
        "small": false,
        "link": null
      }
    ]
  },
  {
    "kind": "paragraph",
    "spans": [
      {
        "text": "Inspired by ",
        "bold": false,
        "italic": false,
        "mono": false,
        "small": false,
        "link": null
      },
      {
        "text": "crowdmap",
        "bold": false,
        "italic": false,
        "mono": false,
        "small": false,
        "link": "https://github.com/yenatch/crowdmap"
      },
      {
        "text": " (now defunct), but implemented with C++ and ",
        "bold": false,
        "italic": false,
        "mono": false,
        "small": false,
        "link": null
      },
      {
        "text": "FLTK",
        "bold": false,
        "italic": false,
        "mono": false,
        "small": false,
        "link": "http://www.fltk.org/"
      },
      {
        "text": ", and with more functions for graphics editing.",
        "bold": false,
        "italic": false,
