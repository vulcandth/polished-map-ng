+    /// Keep the frame's buffer, input, size and pixels unchanged; multiply the
+    /// entire native subsurfaces at the compositor, in sync with the parent.
+    pub fn set_alpha_modifier(&mut self, manager: &WpAlphaModifierV1, multiplier: u32) {
+        self.alpha_modifier = Some((manager.clone(), multiplier));
+        if let Some(render_data) = &mut self.render_data {
+            for part in &mut render_data.parts {
+                let alpha = part.alpha.get_or_insert_with(|| {
+                    manager.get_surface(&part.surface, &self.queue_handle, ())
+                });
+                alpha.set_multiplier(multiplier);
+                part.subsurface.set_sync();
+                // Commit the existing buffer's alpha without reallocating it.
+                // Synchronization defers every part to the next parent commit.
+                part.surface.commit();
+            }
+        }
+        self.should_sync = true;
+        self.dirty = true;
     }
 
